+/// Lets a parked file be dragged out of the notch (plain AppKit, which works in this panel and
+/// reports whether the file was taken).
+struct NotchShelfDragSource: NSViewRepresentable {
+    let url: URL
+    let image: NSImage?
+    let onStart: () -> Void
+    let onEnd: (Bool) -> Void
+
+    func makeNSView(context: Context) -> NotchShelfDragView {
+        NotchShelfDragView()
+    }
+
+    func updateNSView(_ view: NotchShelfDragView, context: Context) {
+        view.url = url
+        view.image = image
+        view.onStart = onStart
+        view.onEnd = onEnd
+        view.toolTip = String(localized: "Drag into any app. Double-click opens it.", table: "NotchIsland")
+    }
+}
+
+final class NotchShelfDragView: NSView, NSDraggingSource {
+    var url: URL?
+    var image: NSImage?
+    var onStart: (() -> Void)?
+    var onEnd: ((Bool) -> Void)?
+    private var mouseDownLocation: NSPoint?
+
+    override func acceptsFirstMouse(for event: NSEvent?) -> Bool { true }
+
+    override func mouseDown(with event: NSEvent) {
+        mouseDownLocation = event.locationInWindow
+        if event.clickCount == 2, let url {
+            mouseDownLocation = nil
+            NSWorkspace.shared.open(url)
         }
-        .buttonStyle(NotchPressStyle())
+    }
+
+    override func mouseUp(with event: NSEvent) {
+        mouseDownLocation = nil
+    }
+
+    override func mouseDragged(with event: NSEvent) {
+        guard let start = mouseDownLocation, let url else { return }
+        let location = event.locationInWindow
+        guard abs(location.x - start.x) > 3 || abs(location.y - start.y) > 3 else { return }
+        mouseDownLocation = nil
+
+        let item = NSDraggingItem(pasteboardWriter: url as NSURL)
+        item.setDraggingFrame(bounds, contents: image ?? NSWorkspace.shared.icon(forFile: url.path))
+        onStart?()
+        let session = beginDraggingSession(with: [item], event: event, source: self)
+        session.animatesToStartingPositionsOnCancelOrFail = true
+    }
+
+    func draggingSession(_ session: NSDraggingSession, sourceOperationMaskFor context: NSDraggingContext) -> NSDragOperation {
+        // Into other apps only, not back onto the notch.
+        context == .outsideApplication ? .copy : []
+    }
+
+    func draggingSession(_ session: NSDraggingSession, endedAt screenPoint: NSPoint, operation: NSDragOperation) {
+        onEnd?(operation != [])
     }
