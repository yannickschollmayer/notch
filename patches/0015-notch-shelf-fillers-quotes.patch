diff --git a/VoiceInk/Features/Recording/Presentation/NotchShelf.swift b/VoiceInk/Features/Recording/Presentation/NotchShelf.swift
new file mode 100644
index 0000000..c9bb88f
--- /dev/null
+++ b/VoiceInk/Features/Recording/Presentation/NotchShelf.swift
@@ -0,0 +1,227 @@
+import AppKit
+import QuickLookThumbnailing
+import os
+
+/// Files parked on the notch ("Park"): dropped there from any app and dragged out again into any
+/// other, e.g. a PDF from WhatsApp into a Claude chat. The shelf keeps its own copy of each file
+/// (an instant clone on the same disk), so files that an app only lends for the drag stay there.
+@MainActor
+final class NotchShelf: ObservableObject {
+    struct Item: Identifiable, Equatable {
+        let id = UUID()
+        let name: String
+        /// The shelf's copy; nil while it is still being written.
+        var url: URL?
+        var thumbnail: NSImage?
+    }
+
+    @Published private(set) var items: [Item] = []
+    /// A file is being dragged out of the shelf right now.
+    @Published private(set) var isDraggingOut = false
+
+    nonisolated static let folder = FileManager.default.temporaryDirectory
+        .appendingPathComponent("VoiceInk Notch Shelf", isDirectory: true)
+
+    private var dragWatch: Task<Void, Never>?
+    private let logger = Logger(subsystem: "com.prakashjoshipax.voiceink", category: "NotchShelf")
+
+    init() {
+        // Leftovers from the last run.
+        try? FileManager.default.removeItem(at: Self.folder)
+    }
+
+    /// Whether a file is one of the shelf's own, so dragging it out is not taken for a new file.
+    nonisolated static func contains(_ url: URL) -> Bool {
+        let base = folder.resolvingSymlinksInPath().path + "/"
+        return url.resolvingSymlinksInPath().path.hasPrefix(base)
+    }
+
+    // MARK: Adding
+
+    func add(_ urls: [URL]) {
+        for source in urls {
+            let item = Item(name: source.lastPathComponent, url: nil, thumbnail: NSWorkspace.shared.icon(forFile: source.path))
+            items.append(item)
+            let id = item.id
+            let target = Self.folder
+                .appendingPathComponent(id.uuidString, isDirectory: true)
+                .appendingPathComponent(source.lastPathComponent)
+            Task.detached(priority: .userInitiated) { [weak self] in
+                let copied = NotchPromisedFiles.copy(source, to: target)
+                await self?.finishCopy(id, url: copied)
+            }
+        }
+    }
+
+    /// Promised files (WhatsApp, Mail …): asked for during the drop, they appear once written.
+    func receive(_ promises: [NSFilePromiseReceiver]) {
+        guard !promises.isEmpty else { return }
+        NotchPromisedFiles.receiveEach(promises) { [weak self] url in
+            self?.append(url)
+        }
+    }
+
+    private func finishCopy(_ id: UUID, url: URL?) {
+        guard let index = items.firstIndex(where: { $0.id == id }) else { return }
+        guard let url else {
+            logger.error("Notch shelf: could not copy \(self.items[index].name, privacy: .public)")
+            items.remove(at: index)
+            return
+        }
+        items[index].url = url
+        loadThumbnail(for: id, url: url)
+    }
+
+    private func append(_ url: URL) {
+        let item = Item(name: url.lastPathComponent, url: url, thumbnail: NSWorkspace.shared.icon(forFile: url.path))
+        items.append(item)
+        loadThumbnail(for: item.id, url: url)
+    }
+
+    /// A preview of the content (first PDF page, picture …) instead of the plain file icon.
+    private func loadThumbnail(for id: UUID, url: URL) {
+        let request = QLThumbnailGenerator.Request(
+            fileAt: url,
+            size: CGSize(width: 76, height: 76),
+            scale: NSScreen.main?.backingScaleFactor ?? 2,
+            representationTypes: .thumbnail
+        )
+        Task { @MainActor [weak self] in
+            guard let representation = try? await QLThumbnailGenerator.shared.generateBestRepresentation(for: request),
+                let self,
+                let index = self.items.firstIndex(where: { $0.id == id })
+            else { return }
+            self.items[index].thumbnail = representation.nsImage
+        }
+    }
+
+    // MARK: Removing
+
+    func remove(_ id: UUID) {
+        guard let index = items.firstIndex(where: { $0.id == id }) else { return }
+        let item = items.remove(at: index)
+        guard let url = item.url else { return }
+        // The app the file just went to may still be reading it.
+        Task.detached(priority: .utility) {
+            try? await Task.sleep(nanoseconds: 120_000_000_000)
+            NotchPromisedFiles.delete(url)
+        }
+    }
+
+    func removeAll() {
+        for item in items {
+            remove(item.id)
+        }
+    }
+
+    // MARK: Dragging out
+
+    func dragStarted() {
+        isDraggingOut = true
+        dragWatch?.cancel()
+        dragWatch = Task { @MainActor [weak self] in
+            // Fallback in case the end of the drag is never reported.
+            while !Task.isCancelled, NSEvent.pressedMouseButtons & 1 == 1 {
+                try? await Task.sleep(nanoseconds: 200_000_000)
+            }
+            try? await Task.sleep(nanoseconds: 1_500_000_000)
+            guard let self, !Task.isCancelled else { return }
+            self.isDraggingOut = false
+        }
+    }
+
+    /// Parked files are only on their way somewhere: once delivered, they leave the shelf.
+    func dragEnded(_ id: UUID, delivered: Bool) {
+        dragWatch?.cancel()
+        dragWatch = nil
+        isDraggingOut = false
+        if delivered {
+            remove(id)
+        }
+    }
+}
+
+/// File work off the main thread: copies, promised files, cleanup.
+enum NotchPromisedFiles {
+    /// One at a time, so the callbacks below never run at the same moment.
+    private static let queue: OperationQueue = {
+        let queue = OperationQueue()
+        queue.maxConcurrentOperationCount = 1
+        queue.qualityOfService = .userInitiated
+        return queue
+    }()
+
+    static func copy(_ source: URL, to target: URL) -> URL? {
+        do {
+            try FileManager.default.createDirectory(at: target.deletingLastPathComponent(), withIntermediateDirectories: true)
+            try FileManager.default.copyItem(at: source, to: target)
+            return target
+        } catch {
+            return nil
+        }
+    }
+
+    /// Deletes a shelf file and its folder once that is empty.
+    static func delete(_ url: URL) {
+        let folder = url.deletingLastPathComponent()
+        try? FileManager.default.removeItem(at: url)
+        if let rest = try? FileManager.default.contentsOfDirectory(atPath: folder.path), rest.isEmpty {
+            try? FileManager.default.removeItem(at: folder)
+        }
+    }
+
+    private static func newFolder() -> URL {
+        let folder = NotchShelf.folder.appendingPathComponent(UUID().uuidString, isDirectory: true)
+        try? FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+        return folder
+    }
+
+    /// Asks for each promised file; "arrived" runs on the main thread for every file written.
+    static func receiveEach(_ promises: [NSFilePromiseReceiver], arrived: @escaping @Sendable @MainActor (URL) -> Void) {
+        for promise in promises {
+            promise.receivePromisedFiles(atDestination: newFolder(), options: [:], operationQueue: queue) { url, error in
+                guard error == nil else { return }
+                Task { @MainActor in
+                    arrived(url)
+                }
+            }
+        }
+    }
+
+    /// Asks for all promised files; "completion" runs on the main thread once all have arrived.
+    static func receiveAll(_ promises: [NSFilePromiseReceiver], completion: @escaping @Sendable @MainActor ([URL]) -> Void) {
+        let expected = promises.reduce(0) { $0 + max(1, $1.fileTypes.count) }
+        guard expected > 0 else {
+            Task { @MainActor in
+                completion([])
+            }
+            return
+        }
+        let folder = newFolder()
+        let collector = Collector(remaining: expected)
+        for promise in promises {
+            promise.receivePromisedFiles(atDestination: folder, options: [:], operationQueue: queue) { url, error in
+                if error == nil {
+                    collector.received.append(url)
+                }
+                collector.remaining -= 1
+                if collector.remaining == 0 {
+                    let urls = collector.received
+                    Task { @MainActor in
+                        completion(urls)
+                    }
+                }
+            }
+        }
+    }
+
+    /// Counts the files still to come; only touched on the serial queue above.
+    private final class Collector: @unchecked Sendable {
+        var remaining: Int
+        var received: [URL] = []
+
+        init(remaining: Int) {
+            self.remaining = remaining
+        }
+    }
+}
