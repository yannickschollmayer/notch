+import SwiftUI
+
+/// Dynamic-Island style notch: hidden behind the hardware notch while idle, a little larger on
+/// hover, larger and glowing (Spokenly-style rim light) while dictating.
+struct NotchIslandView: View {
+    @ObservedObject var model: NotchIslandModel
+    let recorder: Recorder
+    @ObservedObject var assistantSession: AssistantSession
+    let onTap: () -> Void
+    let onClose: () -> Void
+    let onAssistantFollowUp: (String) -> Void
+
+    @AppStorage(RecorderDisplaySettingsKeys.showLiveTranscript) private var showLiveTranscript = true
+
+    private let morph = Animation.spring(response: 0.38, dampingFraction: 0.80)
+
+    var body: some View {
+        let phase = model.phase
+        let size = model.size(for: phase)
+
+        island(phase: phase, size: size)
+            .frame(maxWidth: .infinity, maxHeight: .infinity, alignment: .top)
+            .animation(morph, value: phase)
+            .animation(morph, value: model.geometry)
+    }
+
+    // MARK: - Island
+
+    private func island(phase: NotchIslandPhase, size: CGSize) -> some View {
+        let shape = Self.shape(for: phase)
+
+        return VStack(spacing: 0) {
+            mainRow(phase: phase, size: size, topRadius: shape.topCornerRadius)
+            liveTextPanel(phase: phase)
+            assistantPanel(phase: phase)
+        }
+        .frame(width: size.width, height: size.height, alignment: .top)
+        .background(Color.black)
+        .clipShape(shape)
+        .overlay {
+            rim(phase: phase, shape: shape)
+        }
+        .background {
+            NotchIslandGlow(phase: phase, shape: shape, meter: { recorder.audioMeterSnapshot() })
+        }
+        .opacity(phase == .hidden ? 0 : 1)
+    }
+
+    private static func shape(for phase: NotchIslandPhase) -> NotchShape {
+        switch phase {
+        case .hidden, .idle:
+            return NotchShape(topCornerRadius: 4, bottomCornerRadius: 8)
+        case .hover:
+            return NotchShape(topCornerRadius: 6, bottomCornerRadius: 12)
+        case .recording, .processing:
+            return NotchShape(topCornerRadius: 8, bottomCornerRadius: 14)
+        case .liveText, .assistant:
+            return NotchShape(topCornerRadius: 12, bottomCornerRadius: 22)
+        }
+    }
+
+    @ViewBuilder
+    private func rim(phase: NotchIslandPhase, shape: NotchShape) -> some View {
+        switch phase {
+        case .recording, .liveText:
+            shape.stroke(NotchIslandGlow.recordingColor.opacity(0.65), lineWidth: 1)
+        case .processing:
+            shape.stroke(NotchIslandGlow.processingColor.opacity(0.5), lineWidth: 1)
+        default:
+            EmptyView()
+        }
+    }
+
+    // MARK: - Main row (the part beside the hardware notch)
+
+    private func mainRow(phase: NotchIslandPhase, size: CGSize, topRadius: CGFloat) -> some View {
+        let wing = max(0, (size.width - model.geometry.notchWidth) / 2)
+        let rowHeight = model.rowHeight
+
+        return HStack(spacing: 0) {
+            leftWing(phase: phase)
+                .padding(.leading, topRadius)
+                .frame(width: wing, height: rowHeight)
+            Spacer(minLength: 0)
+            rightWing(phase: phase, rowHeight: rowHeight)
+                .padding(.trailing, topRadius)
+                .frame(width: wing, height: rowHeight)
+        }
+        .frame(width: size.width, height: rowHeight)
+        .clipped()
+        .contentShape(Rectangle())
+        .onTapGesture {
+            switch phase {
+            case .hidden, .idle, .hover, .recording, .liveText:
+                onTap()
+            case .processing, .assistant:
+                break
+            }
+        }
+    }
+
+    @ViewBuilder
+    private func leftWing(phase: NotchIslandPhase) -> some View {
+        Group {
+            switch phase {
+            case .hover:
+                Image(systemName: "mic.fill")
+                    .font(.system(size: 11, weight: .semibold))
+                    .foregroundStyle(Color.white.opacity(0.9))
+            case .recording, .liveText, .processing:
+                targetAppBadge(phase: phase)
+            case .assistant:
+                if model.recordingState == .idle && !assistantSession.isBusy {
+                    RecorderCloseButton(action: onClose)
+                } else {
+                    targetAppBadge(phase: phase)
+                }
+            case .hidden, .idle:
+                Color.clear
+            }
+        }
+        .transition(.opacity)
+        .animation(.easeOut(duration: 0.18).delay(0.06), value: phase)
+    }
+
+    @ViewBuilder
+    private func targetAppBadge(phase: NotchIslandPhase) -> some View {
+        if let icon = model.targetAppIcon {
+            Image(nsImage: icon)
+                .resizable()
+                .interpolation(.high)
+                .frame(width: 18, height: 18)
+        } else {
+            Circle()
+                .fill(phase == .processing ? NotchIslandGlow.processingColor : NotchIslandGlow.recordingColor)
+                .frame(width: 7, height: 7)
+        }
+    }
+
+    @ViewBuilder
+    private func rightWing(phase: NotchIslandPhase, rowHeight: CGFloat) -> some View {
+        Group {
+            switch phase {
+            case .hover:
+                Image(systemName: "waveform")
+                    .font(.system(size: 10, weight: .semibold))
+                    .foregroundStyle(Color.white.opacity(0.55))
+            case .recording, .liveText:
+                NotchIslandWaveform(
+                    meter: { recorder.audioMeterSnapshot() },
+                    isActive: model.recordingState == .recording,
+                    maxHeight: max(8, min(18, rowHeight - 12))
+                )
+            case .processing:
+                NotchIslandProcessingDots()
+            case .assistant:
+                if assistantSession.isBusy || model.recordingState != .idle {
+                    NotchIslandProcessingDots()
+                } else {
+                    Color.clear
+                }
+            case .hidden, .idle:
+                Color.clear
+            }
+        }
+        .transition(.opacity)
+        .animation(.easeOut(duration: 0.18).delay(0.06), value: phase)
+    }
+
+    // MARK: - Panels below the notch
+
+    @ViewBuilder
+    private func liveTextPanel(phase: NotchIslandPhase) -> some View {
+        if phase == .liveText {
+            VStack(spacing: 0) {
+                Divider().background(Color.white.opacity(0.15))
+                LiveTranscriptView(text: model.partialTranscript)
+                    .padding(.horizontal, 8)
+            }
+            .frame(height: NotchIslandModel.liveTextPanelHeight)
+            .clipped()
+            .transition(.opacity)
+        }
+    }
+
+    @ViewBuilder
+    private func assistantPanel(phase: NotchIslandPhase) -> some View {
+        if phase == .assistant {
+            VStack(spacing: 0) {
+                Divider().background(Color.white.opacity(0.15))
+                AssistantPanelView(
+                    session: assistantSession,
+                    liveFollowUpText: showLiveTranscript && model.recordingState == .recording
+                        ? model.partialTranscript : "",
+                    onSend: onAssistantFollowUp
+                )
+            }
+            .frame(height: NotchIslandModel.assistantPanelHeight)
+            .clipped()
+            .transition(.opacity)
+        }
+    }
+}
+
+// MARK: - Glow
+
+struct NotchIslandGlow: View {
+    static let recordingColor = Color(red: 1.0, green: 0.30, blue: 0.36)
+    static let processingColor = Color(red: 0.62, green: 0.46, blue: 1.0)
+
+    let phase: NotchIslandPhase
+    let shape: NotchShape
+    let meter: () -> AudioMeter
+
+    var body: some View {
+        switch phase {
+        case .recording, .liveText:
+            TimelineView(.animation(minimumInterval: 1.0 / 30.0)) { _ in
+                let level = CGFloat(max(0, min(1, pow(meter().averagePower, 0.7))))
+                glow(color: Self.recordingColor, strength: 0.55 + 0.4 * level, radius: 9 + 10 * level)
+            }
+        case .processing:
+            TimelineView(.animation(minimumInterval: 1.0 / 30.0)) { context in
+                let time = context.date.timeIntervalSinceReferenceDate
+                let pulse = CGFloat((sin(time * 3.2) + 1) / 2)
+                glow(color: Self.processingColor, strength: 0.38 + 0.3 * pulse, radius: 8 + 5 * pulse)
+            }
+        case .hover:
+            glow(color: .white, strength: 0.16, radius: 8)
+        case .hidden, .idle, .assistant:
+            Color.clear
+        }
+    }
+
+    private func glow(color: Color, strength: CGFloat, radius: CGFloat) -> some View {
+        shape
+            .fill(Color.black)
+            .shadow(color: color.opacity(strength), radius: radius * 0.5)
+            .shadow(color: color.opacity(strength * 0.6), radius: radius * 1.4)
+    }
+}
+
+// MARK: - Waveform
+
+struct NotchIslandWaveform: View {
+    let meter: () -> AudioMeter
+    let isActive: Bool
+    let maxHeight: CGFloat
+
+    private let barCount = 5
+    private let barWidth: CGFloat = 3
+    private let minHeight: CGFloat = 3
+
+    var body: some View {
+        TimelineView(.animation(minimumInterval: 1.0 / 30.0)) { context in
+            let level = isActive ? max(0, min(1, pow(meter().averagePower, 0.7))) : 0
+            let time = context.date.timeIntervalSinceReferenceDate
+
+            HStack(spacing: 2.5) {
+                ForEach(0..<barCount, id: \.self) { index in
+                    Capsule()
+                        .fill(Color.white.opacity(0.92))
+                        .frame(width: barWidth, height: barHeight(index: index, level: level, time: time))
+                }
+            }
+        }
+    }
+
+    private func barHeight(index: Int, level: Double, time: TimeInterval) -> CGFloat {
+        let wave = (sin(time * 9 + Double(index) * 0.9) + 1) / 2
+        let middle = Double(barCount - 1) / 2
+        let centerBoost = 1 - abs(Double(index) - middle) / Double(barCount) * 0.8
+        let value = level * (0.35 + 0.65 * wave) * centerBoost
+        return minHeight + CGFloat(value) * (maxHeight - minHeight)
+    }
+}
+
+// MARK: - Processing dots
+
+struct NotchIslandProcessingDots: View {
+    var body: some View {
+        TimelineView(.animation(minimumInterval: 1.0 / 30.0)) { context in
+            let time = context.date.timeIntervalSinceReferenceDate
+            HStack(spacing: 3.5) {
+                ForEach(0..<3, id: \.self) { index in
+                    let phase = (sin(time * 6 - Double(index) * 0.8) + 1) / 2
+                    Circle()
+                        .fill(Color.white)
+                        .frame(width: 4, height: 4)
+                        .opacity(0.3 + 0.7 * phase)
+                }
+            }
+        }
+    }
+}
