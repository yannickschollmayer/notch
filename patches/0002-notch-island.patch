+import AppKit
+import Combine
+import SwiftUI
+import os
+
+// MARK: - Geometry
+
+/// Size of the hardware notch (or a virtual one on displays without a notch).
+struct NotchGeometry: Equatable {
+    let screenFrame: NSRect
+    let notchWidth: CGFloat
+    let notchHeight: CGFloat
+    let hasNotch: Bool
+
+    @MainActor
+    static func make(for screen: NSScreen) -> NotchGeometry {
+        let hasNotch = screen.safeAreaInsets.top > 0
+
+        let height: CGFloat = {
+            if hasNotch { return screen.safeAreaInsets.top }
+            let menuBar = NSApplication.shared.mainMenu?.menuBarHeight ?? 0
+            return menuBar > 0 ? menuBar : NSStatusBar.system.thickness
+        }()
+
+        let width: CGFloat = {
+            if let left = screen.auxiliaryTopLeftArea?.width,
+                let right = screen.auxiliaryTopRightArea?.width
+            {
+                return screen.frame.width - left - right
+            }
+            return 180
+        }()
+
+        return NotchGeometry(screenFrame: screen.frame, notchWidth: width, notchHeight: height, hasNotch: hasNotch)
+    }
+
+    static let fallback = NotchGeometry(
+        screenFrame: NSRect(x: 0, y: 0, width: 1440, height: 900),
+        notchWidth: 180,
+        notchHeight: 32,
+        hasNotch: false
+    )
+}
+
+// MARK: - Phase
+
+enum NotchIslandPhase: Equatable {
+    /// Nothing drawn (display without a notch, nothing going on).
+    case hidden
+    /// Sits invisibly behind the hardware notch.
+    case idle
+    /// Pointer is on the notch: grows a little and can be clicked to start dictating.
+    case hover
+    /// Listening. Slightly larger than the notch and glowing.
+    case recording
+    /// Transcribing / AI clean-up.
+    case processing
+    /// Listening with streaming text shown underneath.
+    case liveText
+    /// Assistant answer panel.
+    case assistant
+
+    var isActive: Bool {
+        switch self {
+        case .recording, .processing, .liveText, .assistant: return true
+        case .hidden, .idle, .hover: return false
+        }
+    }
+}
+
+// MARK: - Model
+
+@MainActor
+final class NotchIslandModel: ObservableObject {
+    @Published var geometry: NotchGeometry
+    @Published var isHovering = false
+    @Published var sessionActive = false
+    @Published var targetAppIcon: NSImage?
+    @Published private(set) var recordingState: RecordingState = .idle
+    @Published private(set) var partialTranscript = ""
+    @Published private(set) var assistantVisible = false
+
+    private var cancellables = Set<AnyCancellable>()
+
+    // Extra width on each side of the notch and extra height below it, per phase.
+    static let hoverWing: CGFloat = 22
+    static let activeWing: CGFloat = 50
+    static let liveTextWing: CGFloat = 110
+    static let assistantWing: CGFloat = 230
+    static let rowBonus: CGFloat = 5
+    static let liveTextPanelHeight: CGFloat = 57
+    static let assistantPanelHeight: CGFloat = 320
+    /// Room around the island for the glow.
+    static let glowPadding: CGFloat = 34
+
+    init(engine: VoiceInkEngine, geometry: NotchGeometry) {
+        self.geometry = geometry
+
+        engine.$recordingState
+            .removeDuplicates()
+            .sink { [weak self] state in self?.recordingState = state }
+            .store(in: &cancellables)
+
+        engine.$partialTranscript
+            .removeDuplicates()
+            .sink { [weak self] text in self?.partialTranscript = text }
+            .store(in: &cancellables)
+
+        engine.assistantSession.$phase
+            .map { $0 != .inactive }
+            .removeDuplicates()
+            .sink { [weak self] visible in self?.assistantVisible = visible }
+            .store(in: &cancellables)
+    }
+
+    private var showsLiveTranscript: Bool {
+        UserDefaults.standard.object(forKey: RecorderDisplaySettingsKeys.showLiveTranscript) as? Bool ?? true
+    }
+
+    var phase: NotchIslandPhase {
+        if assistantVisible { return .assistant }
+
+        switch recordingState {
+        case .recording:
+            return showsLiveTranscript && !partialTranscript.isEmpty ? .liveText : .recording
+        case .starting:
+            return .recording
+        case .transcribing, .enhancing, .busy:
+            return .processing
+        case .idle:
+            break
+        }
+
+        if isHovering { return .hover }
+        return geometry.hasNotch ? .idle : .hidden
+    }
+
+    var rowHeight: CGFloat {
+        switch phase {
+        case .hidden, .idle: return geometry.notchHeight
+        default: return geometry.notchHeight + Self.rowBonus
+        }
+    }
+
+    func size(for phase: NotchIslandPhase) -> CGSize {
+        let width = geometry.notchWidth
+        let height = geometry.notchHeight
+        let row = height + Self.rowBonus
+
+        switch phase {
+        case .hidden:
+            return CGSize(width: width, height: 0)
+        case .idle:
+            // A touch smaller than the hardware notch so no edge ever peeks out.
+            return CGSize(width: max(0, width - 8), height: max(0, height - 2))
+        case .hover:
+            return CGSize(width: width + Self.hoverWing * 2, height: row)
+        case .recording, .processing:
+            return CGSize(width: width + Self.activeWing * 2, height: row)
+        case .liveText:
+            return CGSize(width: width + Self.liveTextWing * 2, height: row + Self.liveTextPanelHeight)
+        case .assistant:
+            return CGSize(width: width + Self.assistantWing * 2, height: row + Self.assistantPanelHeight)
+        }
+    }
+
+    /// Fixed size of the transparent window that hosts the island in every phase.
+    var windowSize: CGSize {
+        let largest = size(for: .assistant)
+        return CGSize(
+            width: largest.width + Self.glowPadding * 2,
+            height: largest.height + Self.glowPadding
+        )
+    }
+
+    /// Screen rect in which the pointer counts as "on the island".
+    func hitRect() -> NSRect {
+        let current = phase
+        let size: CGSize
+        switch current {
+        case .hidden, .idle:
+            size = CGSize(width: geometry.notchWidth, height: geometry.notchHeight)
+        default:
+            size = self.size(for: current)
+        }
+        let frame = geometry.screenFrame
+        return NSRect(
+            x: frame.midX - size.width / 2,
+            y: frame.maxY - size.height,
+            width: size.width,
+            height: size.height
+        ).insetBy(dx: -3, dy: -3)
+    }
+}
+
+// MARK: - Window
+
+final class NotchIslandPanel: NSPanel {
+    /// Only the assistant panel has a text field; otherwise the island never takes key focus,
+    /// so the app you are dictating into keeps it.
+    var allowsKey = false
+
+    override var canBecomeKey: Bool { allowsKey }
+    override var canBecomeMain: Bool { false }
+
+    init(contentRect: NSRect) {
+        super.init(
+            contentRect: contentRect,
+            styleMask: [.borderless, .nonactivatingPanel],
+            backing: .buffered,
+            defer: false
+        )
+        isFloatingPanel = true
+        level = NSWindow.Level(rawValue: NSWindow.Level.statusBar.rawValue + 3)
+        backgroundColor = .clear
+        isOpaque = false
+        hasShadow = false
+        hidesOnDeactivate = false
+        canHide = false
+        isMovable = false
+        isMovableByWindowBackground = false
+        ignoresMouseEvents = true
+        acceptsMouseMovedEvents = true
+        collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary, .stationary, .ignoresCycle]
+        appearance = NSAppearance(named: .darkAqua)
+    }
+}
+
+final class NotchIslandHostingView<Content: View>: NSHostingView<Content> {
+    override func acceptsFirstMouse(for event: NSEvent?) -> Bool { true }
+}
+
+// MARK: - Controller
+
+/// Owns the always-present notch window: invisible behind the hardware notch while idle,
+/// a little larger and clickable on hover, larger and glowing while dictating.
+@MainActor
+final class NotchIslandController {
+    let model: NotchIslandModel
+
+    private let recorder: Recorder
+    private let assistantSession: AssistantSession
+    private let onTap: () -> Void
+    private let onClose: () -> Void
+    private let onAssistantFollowUp: (String) -> Void
+
+    private var panel: NotchIslandPanel?
+    private var eventMonitors: [Any] = []
+    private var hoverExitTask: Task<Void, Never>?
+    private var repositionTask: Task<Void, Never>?
+    private var cancellables = Set<AnyCancellable>()
+    private let logger = Logger(subsystem: "com.prakashjoshipax.voiceink", category: "NotchIsland")
+
+    init(
+        engine: VoiceInkEngine,
+        recorder: Recorder,
+        onTap: @escaping () -> Void,
+        onClose: @escaping () -> Void,
+        onAssistantFollowUp: @escaping (String) -> Void
+    ) {
+        let screen = NotchIslandController.idleScreen()
+        self.model = NotchIslandModel(engine: engine, geometry: screen.map { NotchGeometry.make(for: $0) } ?? .fallback)
+        self.recorder = recorder
+        self.assistantSession = engine.assistantSession
+        self.onTap = onTap
+        self.onClose = onClose
+        self.onAssistantFollowUp = onAssistantFollowUp
+
+        // objectWillChange fires before the new value is stored; hop once so we read the result.
+        model.objectWillChange
+            .receive(on: DispatchQueue.main)
+            .sink { [weak self] _ in self?.modelDidChange() }
+            .store(in: &cancellables)
+    }
+
+    // MARK: Screens
+
+    /// The idle island lives on the display with the notch, or on the main display otherwise.
+    private static func idleScreen() -> NSScreen? {
+        NSScreen.screens.first(where: { $0.safeAreaInsets.top > 0 }) ?? RecorderScreenResolver.resolve()
+    }
+
+    // MARK: Public API
+
+    /// Puts the idle island in place (call once the notch style is selected).
+    func showIdle() {
+        ensurePanel()
+        guard let screen = model.sessionActive ? RecorderScreenResolver.resolve() : NotchIslandController.idleScreen() else { return }
+        place(on: screen)
+        installEventMonitors()
+    }
+
+    /// A dictation started: move to the screen being worked on and expand.
+    @discardableResult
+    func beginSession() -> Bool {
+        guard let screen = RecorderScreenResolver.resolve() else {
+            logger.error("Notch island: no screen for session")
+            return false
+        }
+        repositionTask?.cancel()
+        ensurePanel()
+
+        if let app = NSWorkspace.shared.frontmostApplication,
+            app.bundleIdentifier != Bundle.main.bundleIdentifier
+        {
+            model.targetAppIcon = app.icon
+        } else {
+            model.targetAppIcon = nil
+        }
+
+        place(on: screen)
+        installEventMonitors()
+        model.sessionActive = true
+        return true
+    }
+
+    /// The dictation ended: collapse, then return to the notch display if it moved.
+    func endSession() {
+        model.sessionActive = false
+        repositionTask?.cancel()
+        repositionTask = Task { @MainActor [weak self] in
+            // Let the collapse animation finish before the window jumps screens.
+            try? await Task.sleep(nanoseconds: 600_000_000)
+            guard let self, !Task.isCancelled, !self.model.sessionActive else { return }
+            if let screen = NotchIslandController.idleScreen(),
+                NotchGeometry.make(for: screen) != self.model.geometry
+            {
+                self.place(on: screen)
+            }
+        }
+    }
+
+    /// Rebuilds the window, e.g. after sleep or a display change, when windows can go stale.
+    func refresh() {
+        destroyPanel()
+        showIdle()
+    }
+
+    func destroy() {
+        repositionTask?.cancel()
+        hoverExitTask?.cancel()
+        removeEventMonitors()
+        destroyPanel()
+    }
+
+    // MARK: Window
+
+    private func ensurePanel() {
+        guard panel == nil else { return }
+
+        let newPanel = NotchIslandPanel(contentRect: .zero)
+        let view = NotchIslandView(
+            model: model,
+            recorder: recorder,
+            assistantSession: assistantSession,
+            onTap: onTap,
+            onClose: onClose,
+            onAssistantFollowUp: onAssistantFollowUp
+        )
+        let hosting = NotchIslandHostingView(rootView: view)
+        hosting.sizingOptions = []
+        hosting.wantsLayer = true
+        hosting.layer?.backgroundColor = NSColor.clear.cgColor
+        newPanel.contentView = hosting
+        panel = newPanel
+    }
+
+    private func destroyPanel() {
+        panel?.orderOut(nil)
+        panel?.close()
+        panel = nil
+    }
+
+    private func place(on screen: NSScreen) {
+        let geometry = NotchGeometry.make(for: screen)
+        if geometry != model.geometry {
+            model.geometry = geometry
+        }
+
+        guard let panel else { return }
+        let size = model.windowSize
+        let frame = NSRect(
+            x: screen.frame.midX - size.width / 2,
+            y: screen.frame.maxY - size.height,
+            width: size.width,
+            height: size.height
+        )
+        panel.setFrame(frame, display: true)
+        panel.orderFrontRegardless()
+        updatePointerState()
+    }
+
+    // MARK: Pointer tracking
+
+    private func installEventMonitors() {
+        guard eventMonitors.isEmpty else { return }
+        let mask: NSEvent.EventTypeMask = [.mouseMoved, .leftMouseDragged]
+
+        if let global = NSEvent.addGlobalMonitorForEvents(matching: mask, handler: { [weak self] _ in
+            Task { @MainActor [weak self] in self?.updatePointerState() }
+        }) {
+            eventMonitors.append(global)
+        }
+
+        if let local = NSEvent.addLocalMonitorForEvents(matching: mask, handler: { [weak self] event in
+            Task { @MainActor [weak self] in self?.updatePointerState() }
+            return event
+        }) {
+            eventMonitors.append(local)
+        }
+    }
+
+    private func removeEventMonitors() {
+        for monitor in eventMonitors {
+            NSEvent.removeMonitor(monitor)
+        }
+        eventMonitors.removeAll()
+    }
+
+    /// The window is much larger than the island (room for every phase plus the glow), so it
+    /// lets clicks fall through to the menu bar unless the pointer is actually on the island.
+    private func updatePointerState() {
+        guard let panel else { return }
+        let inside = model.hitRect().contains(NSEvent.mouseLocation)
+
+        if panel.ignoresMouseEvents == inside {
+            panel.ignoresMouseEvents = !inside
+        }
+
+        if inside {
+            hoverExitTask?.cancel()
+            hoverExitTask = nil
+            if !model.isHovering {
+                model.isHovering = true
+            }
+        } else if model.isHovering, hoverExitTask == nil {
+            hoverExitTask = Task { @MainActor [weak self] in
+                try? await Task.sleep(nanoseconds: 150_000_000)
+                guard let self, !Task.isCancelled else { return }
+                self.hoverExitTask = nil
+                if !self.model.hitRect().contains(NSEvent.mouseLocation) {
+                    self.model.isHovering = false
+                }
+            }
+        }
+    }
+
+    private func modelDidChange() {
+        guard let panel else { return }
+        let wantsKey = model.phase == .assistant
+        if panel.allowsKey != wantsKey {
+            panel.allowsKey = wantsKey
+        }
+        updatePointerState()
+    }
+}
