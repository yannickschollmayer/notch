+    /// Up to three clearly different colours of the cover, made bright and vivid enough to glow.
+    /// White, grey and black parts don't count, so light covers glow in their colours instead of
+    /// a pale haze.
+    private static func glowColors(of image: NSImage) -> [NSColor] {
+        guard let cgImage = image.cgImage(forProposedRect: nil, context: nil, hints: nil),
+              let space = CGColorSpace(name: CGColorSpace.sRGB) else { return [] }
+        let side = 24
+        var pixels = [UInt8](repeating: 0, count: side * side * 4)
+        let drawn = pixels.withUnsafeMutableBytes { buffer -> Bool in
+            guard let context = CGContext(
+                data: buffer.baseAddress,
+                width: side,
+                height: side,
+                bitsPerComponent: 8,
+                bytesPerRow: side * 4,
+                space: space,
+                bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
+            ) else { return false }
+            context.interpolationQuality = .medium
+            context.draw(cgImage, in: CGRect(x: 0, y: 0, width: side, height: side))
+            return true
+        }
+        guard drawn else { return [] }
+
+        // Colourful pixels sorted by hue; vivid ones count more.
+        let bins = 12
+        var weights = [Double](repeating: 0, count: bins)
+        var sums = [(red: Double, green: Double, blue: Double)](repeating: (0, 0, 0), count: bins)
+        for index in stride(from: 0, to: pixels.count, by: 4) {
+            let red = Double(pixels[index]) / 255
+            let green = Double(pixels[index + 1]) / 255
+            let blue = Double(pixels[index + 2]) / 255
+            let high = max(red, green, blue)
+            let chroma = high - min(red, green, blue)
+            guard high > 0.15, chroma > 0.06, chroma / high > 0.12 else { continue }
+            var hue: Double
+            if high == red {
+                hue = (green - blue) / chroma
+            } else if high == green {
+                hue = (blue - red) / chroma + 2
+            } else {
+                hue = (red - green) / chroma + 4
+            }
+            hue = (hue / 6).truncatingRemainder(dividingBy: 1)
+            if hue < 0 { hue += 1 }
+            let bin = min(Int(hue * Double(bins)), bins - 1)
+            let weight = chroma * chroma
+            weights[bin] += weight
+            sums[bin].red += red * weight
+            sums[bin].green += green * weight
+            sums[bin].blue += blue * weight
+        }
+        guard let strongest = weights.max(), strongest > 0.15 else { return [] }
+
+        // The strongest hues that are not neighbours of one already chosen.
+        var chosen: [Int] = []
+        for bin in weights.indices.sorted(by: { weights[$0] > weights[$1] }) {
+            guard chosen.count < 3, weights[bin] >= strongest * 0.03 else { break }
+            let apart = chosen.allSatisfy { other in
+                let distance = abs(other - bin)
+                return min(distance, bins - distance) >= 2
+            }
+            if apart { chosen.append(bin) }
+        }
+
+        var colors = chosen.map { bin -> (hue: CGFloat, saturation: CGFloat, brightness: CGFloat) in
+            let weight = weights[bin]
+            let average = NSColor(
+                srgbRed: sums[bin].red / weight,
+                green: sums[bin].green / weight,
+                blue: sums[bin].blue / weight,
+                alpha: 1
+            )
+            var hue: CGFloat = 0
+            var saturation: CGFloat = 0
+            var brightness: CGFloat = 0
+            average.getHue(&hue, saturation: &saturation, brightness: &brightness, alpha: nil)
+            return (hue, min(1, max(saturation * 1.35, 0.5)), min(max(brightness, 0.82), 0.97))
+        }
+        // A cover in one colour still glows in a few shades of it.
+        if colors.count == 1, let only = colors.first {
+            colors.append(((only.hue + 0.07).truncatingRemainder(dividingBy: 1), only.saturation, only.brightness))
+            colors.append(((only.hue + 0.94).truncatingRemainder(dividingBy: 1), only.saturation * 0.7, min(1, only.brightness * 1.05)))
+        }
+        return colors.map { NSColor(hue: $0.hue, saturation: $0.saturation, brightness: $0.brightness, alpha: 1) }
+    }
