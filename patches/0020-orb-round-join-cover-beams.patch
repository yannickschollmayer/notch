+/// Smooths the orb's movement: quick to swell, a little slower to settle.
+final class NotchOrbSmoother {
+    private var value: Double = 0
+    private var lastTime: TimeInterval = 0
+
+    func advance(to target: Double, at time: TimeInterval) -> Double {
+        let delta = lastTime > 0 ? min(max(time - lastTime, 0), 0.1) : 1.0 / 60.0
+        lastTime = time
+        let rate = target > value ? 14.0 : 5.0
+        value += (target - value) * min(1, rate * delta)
+        return value
