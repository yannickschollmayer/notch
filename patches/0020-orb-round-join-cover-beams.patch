+/// Soft beams of light in the given colours, running out from the centre in different directions
+/// and slowly swaying while the song plays (still while paused).
+struct NotchCoverGlow: View {
+    let colors: [Color]
+    let isPlaying: Bool
+
+    private struct Beam {
+        /// Degrees: 0 points right, 90 down.
+        let angle: Double
+        let length: CGFloat
+        let width: CGFloat
+        let color: Int
+    }
+
+    private static let beams: [Beam] = [
+        Beam(angle: 168, length: 92, width: 32, color: 0),
+        Beam(angle: 100, length: 84, width: 36, color: 0),
+        Beam(angle: 134, length: 104, width: 26, color: 1),
+        Beam(angle: 50, length: 70, width: 26, color: 2),
+        Beam(angle: 208, length: 72, width: 24, color: 1),
+        Beam(angle: 76, length: 60, width: 22, color: 2),
+    ]
+
+    var body: some View {
+        TimelineView(.animation(minimumInterval: 1.0 / 30.0, paused: !isPlaying)) { context in
+            let time = context.date.timeIntervalSinceReferenceDate
+            ZStack {
+                ForEach(Self.beams.indices, id: \.self) { index in
+                    beam(Self.beams[index], index: index, time: time)
+                }
+            }
+            .blur(radius: 11)
+        }
+    }
+
+    private func beam(_ beam: Beam, index: Int, time: Double) -> some View {
+        let phase = Double(index) * 1.7
+        let angle = beam.angle + 9 * sin(time * 0.35 + phase)
+        let length = beam.length * (1 + 0.14 * sin(time * 0.6 + phase * 1.3))
+        let color = colors.isEmpty ? Color.clear : colors[beam.color % colors.count]
+        return Capsule()
+            .fill(
+                LinearGradient(
+                    stops: [
+                        .init(color: color, location: 0),
+                        .init(color: color.opacity(0.75), location: 0.45),
+                        .init(color: color.opacity(0), location: 1),
+                    ],
+                    startPoint: .leading,
+                    endPoint: .trailing
+                )
+            )
+            .frame(width: length, height: beam.width)
+            // Starts in the middle and runs outwards, turned around the middle.
+            .offset(x: length / 2)
+            .rotationEffect(.degrees(angle))
+    }
+}
