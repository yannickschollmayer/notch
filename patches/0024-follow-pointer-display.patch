+    /// The display the pointer is on: the one you are working on.
+    private static func pointerScreen() -> NSScreen? {
+        let point = NSEvent.mouseLocation
+        let screens = NSScreen.screens
+        if let screen = screens.first(where: { NSMouseInRect(point, $0.frame, false) }) {
+            return screen
+        }
+        // Right on an edge: the nearest display.
+        func distance(_ frame: NSRect) -> CGFloat {
+            let dx = max(frame.minX - point.x, 0, point.x - frame.maxX)
+            let dy = max(frame.minY - point.y, 0, point.y - frame.maxY)
+            return dx * dx + dy * dy
+        }
+        return screens.min(by: { distance($0.frame) < distance($1.frame) }) ?? idleScreen()
+    }
+
+    /// Phases in which the island quietly moves along when the pointer goes to another display.
+    /// Open menus, players and dictations stay where they are.
+    private static func followsPointer(_ phase: NotchIslandPhase) -> Bool {
+        switch phase {
+        case .hidden, .idle, .music, .shelfPeek, .dropReady:
+            return true
+        case .hover, .menu, .player, .recording, .processing, .liveText, .assistant, .dropTarget, .fileTask,
+            .shelf:
+            return false
+        }
+    }
+
+    /// Keeps the island (and with it the screen glow) on the display you are working on. On a
+    /// display without a notch it stays invisible until something happens.
+    private func followPointerToScreen() {
+        guard panel != nil, !model.sessionActive,
+            !NSMouseInRect(NSEvent.mouseLocation, model.geometry.screenFrame, false),
+            Self.followsPointer(model.phase),
+            let screen = Self.pointerScreen(), screen.frame != model.geometry.screenFrame
+        else { return }
+        repositionTask?.cancel()
+        place(on: screen)
+    }
+
     // MARK: Public API
