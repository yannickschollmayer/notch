+// MARK: - Press feedback
+
+/// Apple-like feedback for the buttons in the island: a little larger under the pointer, smaller
+/// while pressed, and springing back when let go.
+struct NotchPressStyle: ButtonStyle {
+    enum Highlight {
+        case none
+        /// A soft round light behind icon-only buttons.
+        case circle
+    }
+
+    var hoverScale: CGFloat = 1.06
+    var pressScale: CGFloat = 0.9
+    var highlight: Highlight = .none
+
+    func makeBody(configuration: Configuration) -> some View {
+        NotchPressBody(configuration: configuration, hoverScale: hoverScale, pressScale: pressScale, highlight: highlight)
+    }
+}
+
+private struct NotchPressBody: View {
+    let configuration: ButtonStyleConfiguration
+    let hoverScale: CGFloat
+    let pressScale: CGFloat
+    let highlight: NotchPressStyle.Highlight
+
+    @State private var hovering = false
+
+    var body: some View {
+        let pressed = configuration.isPressed
+
+        configuration.label
+            .background {
+                if highlight == .circle {
+                    Circle()
+                        .fill(Color.white.opacity(pressed ? 0.16 : (hovering ? 0.08 : 0)))
+                        .padding(-2)
+                }
+            }
+            .scaleEffect(pressed ? pressScale : (hovering ? hoverScale : 1))
+            .animation(NotchIslandStyle.press, value: pressed)
+            .animation(.spring(response: 0.3, dampingFraction: 0.72), value: hovering)
+            .onHover { inside in
+                hovering = inside
+            }
+    }
+}
+
+// MARK: - Shoulders
+
+/// Black roundings on both sides of the opened island, below the black strip beside the notch
+/// (menu bar), so the island flows into the top of the screen instead of meeting it at a corner.
+/// Drawn behind the island; its frame is wider than the island by the roundings.
+struct NotchShoulderShape: Shape {
+    /// Width of the island's straight sides apart (without its top curves).
+    var bodyWidth: CGFloat
+    /// Height of the black strip at the top of the screen.
+    var band: CGFloat
+    var radius: CGFloat
+
+    var animatableData: AnimatablePair<CGFloat, AnimatablePair<CGFloat, CGFloat>> {
+        get { AnimatablePair(bodyWidth, AnimatablePair(band, radius)) }
+        set {
+            bodyWidth = newValue.first
+            band = newValue.second.first
+            radius = newValue.second.second
+        }
+    }
+
+    func path(in rect: CGRect) -> Path {
+        var path = Path()
+        guard radius > 0.5, band > 0, bodyWidth > 0 else { return path }
+        let left = rect.midX - bodyWidth / 2
+        let right = rect.midX + bodyWidth / 2
+        let top = rect.minY
+        let strip = top + band
+        let bottom = strip + radius
+        // Reaches 1 pt under the island so no hairline shows between the two.
+        let overlap: CGFloat = 1
+
+        path.move(to: CGPoint(x: left - radius, y: top))
+        path.addLine(to: CGPoint(x: left + overlap, y: top))
+        path.addLine(to: CGPoint(x: left + overlap, y: bottom))
+        path.addLine(to: CGPoint(x: left, y: bottom))
+        path.addArc(
+            tangent1End: CGPoint(x: left, y: strip),
+            tangent2End: CGPoint(x: left - radius, y: strip),
+            radius: radius
+        )
+        path.closeSubpath()
+
+        path.move(to: CGPoint(x: right + radius, y: top))
+        path.addLine(to: CGPoint(x: right - overlap, y: top))
+        path.addLine(to: CGPoint(x: right - overlap, y: bottom))
+        path.addLine(to: CGPoint(x: right, y: bottom))
+        path.addArc(
+            tangent1End: CGPoint(x: right, y: strip),
+            tangent2End: CGPoint(x: right + radius, y: strip),
+            radius: radius
+        )
+        path.closeSubpath()
+        return path
     }
 }
 
