diff --git a/VoiceInk/Features/Recording/Presentation/NotchNowPlaying.swift b/VoiceInk/Features/Recording/Presentation/NotchNowPlaying.swift
new file mode 100644
index 0000000..1219c51
--- /dev/null
+++ b/VoiceInk/Features/Recording/Presentation/NotchNowPlaying.swift
@@ -0,0 +1,284 @@
+import AppKit
+import Combine
+
+/// What Spotify or Apple Music is playing, for the notch.
+///
+/// Both players announce every change (new track, play, pause) as a distributed notification, so
+/// nothing is polled. Cover art and the buttons (play/pause, skip) use AppleScript, and only while
+/// the player is running. macOS asks once whether VoiceInk may control the player.
+@MainActor
+final class NotchNowPlaying: NSObject, ObservableObject {
+    enum Player: String {
+        case spotify
+        case music
+
+        static let all: [Player] = [.spotify, .music]
+
+        var bundleIdentifier: String {
+            switch self {
+            case .spotify: return "com.spotify.client"
+            case .music: return "com.apple.Music"
+            }
+        }
+
+        var scriptName: String {
+            switch self {
+            case .spotify: return "Spotify"
+            case .music: return "Music"
+            }
+        }
+
+        var isRunning: Bool {
+            !NSRunningApplication.runningApplications(withBundleIdentifier: bundleIdentifier).isEmpty
+        }
+    }
+
+    struct Track: Equatable {
+        let player: Player
+        let title: String
+        let artist: String
+        var isPlaying: Bool
+
+        var id: String { player.rawValue + "|" + title + "|" + artist }
+    }
+
+    private struct PlayerInfo: Sendable {
+        let state: String?
+        let title: String?
+        let artist: String?
+    }
+
+    @Published private(set) var track: Track?
+    @Published private(set) var artwork: NSImage?
+
+    private var artworkID: String?
+
+    override init() {
+        super.init()
+        let center = DistributedNotificationCenter.default()
+        // Delivered right away even while VoiceInk is in the background (the default would hold
+        // them back until the app becomes active).
+        center.addObserver(
+            self,
+            selector: #selector(spotifyChanged(_:)),
+            name: Notification.Name("com.spotify.client.PlaybackStateChanged"),
+            object: nil,
+            suspensionBehavior: .deliverImmediately
+        )
+        center.addObserver(
+            self,
+            selector: #selector(musicChanged(_:)),
+            name: Notification.Name("com.apple.Music.playerInfo"),
+            object: nil,
+            suspensionBehavior: .deliverImmediately
+        )
+        NSWorkspace.shared.notificationCenter.addObserver(
+            self,
+            selector: #selector(applicationTerminated(_:)),
+            name: NSWorkspace.didTerminateApplicationNotification,
+            object: nil
+        )
+
+        // A player that was already playing before VoiceInk started says nothing until it changes.
+        Task { @MainActor [weak self] in
+            try? await Task.sleep(nanoseconds: 2_000_000_000)
+            self?.refreshFromRunningPlayers()
+        }
+    }
+
+    deinit {
+        DistributedNotificationCenter.default().removeObserver(self)
+        NSWorkspace.shared.notificationCenter.removeObserver(self)
+    }
+
+    // MARK: Controls
+
+    func playPause() {
+        guard var current = track else { return }
+        send("playpause")
+        // Shown at once; the player's notification confirms it a moment later.
+        current.isPlaying.toggle()
+        track = current
+    }
+
+    func next() {
+        send("next track")
+    }
+
+    func previous() {
+        send("previous track")
+    }
+
+    private func send(_ command: String) {
+        guard let player = track?.player, player.isRunning else { return }
+        let source = Self.script(for: player, command)
+        Task {
+            _ = await NotchAppleScript.run(source)
+        }
+    }
+
+    // MARK: Notifications
+
+    @objc nonisolated private func spotifyChanged(_ notification: Notification) {
+        let info = Self.info(from: notification)
+        Task { @MainActor [weak self] in
+            self?.handle(info, from: .spotify)
+        }
+    }
+
+    @objc nonisolated private func musicChanged(_ notification: Notification) {
+        let info = Self.info(from: notification)
+        Task { @MainActor [weak self] in
+            self?.handle(info, from: .music)
+        }
+    }
+
+    @objc nonisolated private func applicationTerminated(_ notification: Notification) {
+        let app = notification.userInfo?[NSWorkspace.applicationUserInfoKey] as? NSRunningApplication
+        let bundleIdentifier = app?.bundleIdentifier
+        Task { @MainActor [weak self] in
+            guard let self, let track = self.track, track.player.bundleIdentifier == bundleIdentifier else { return }
+            self.clear()
+        }
+    }
+
+    nonisolated private static func info(from notification: Notification) -> PlayerInfo {
+        let info = notification.userInfo ?? [:]
+        return PlayerInfo(
+            state: info["Player State"] as? String,
+            title: info["Name"] as? String,
+            artist: info["Artist"] as? String
+        )
+    }
+
+    private func handle(_ info: PlayerInfo, from player: Player) {
+        if info.state == "Stopped" {
+            if track?.player == player {
+                clear()
+            }
+            return
+        }
+
+        let playing = info.state == "Playing"
+        guard let title = info.title, !title.isEmpty else {
+            // Only the state changed.
+            if var current = track, current.player == player, info.state != nil {
+                current.isPlaying = playing
+                track = current
+            }
+            return
+        }
+
+        // Pausing one player must not hide what another one is playing.
+        if let current = track, current.player != player, current.isPlaying, !playing {
+            return
+        }
+
+        let newTrack = Track(player: player, title: title, artist: info.artist ?? "", isPlaying: playing)
+        if newTrack != track {
+            track = newTrack
+        }
+        loadArtworkIfNeeded()
+    }
+
+    private func clear() {
+        track = nil
+        artwork = nil
+        artworkID = nil
+    }
+
+    private func refreshFromRunningPlayers() {
+        guard track == nil else { return }
+        for player in Player.all where player.isRunning {
+            let source = Self.script(
+                for: player,
+                """
+                if player state is stopped then return ""
+                set stateName to "Paused"
+                if player state is playing then set stateName to "Playing"
+                return stateName & linefeed & (name of current track) & linefeed & (artist of current track)
+                """
+            )
+            Task { @MainActor [weak self] in
+                guard let output = await NotchAppleScript.run(source)?.string, !output.isEmpty else { return }
+                let parts = output.components(separatedBy: "\n")
+                guard parts.count >= 3, let self, self.track == nil else { return }
+                self.handle(PlayerInfo(state: parts[0], title: parts[1], artist: parts[2]), from: player)
+            }
+        }
+    }
+
+    // MARK: Artwork
+
+    private func loadArtworkIfNeeded() {
+        guard let track, track.id != artworkID else { return }
+        artworkID = track.id
+        artwork = nil
+        let id = track.id
+        let player = track.player
+
+        Task { @MainActor [weak self] in
+            // Give the player a moment to switch its current track.
+            try? await Task.sleep(nanoseconds: 250_000_000)
+            guard self?.artworkID == id else { return }
+            let image = await Self.fetchArtwork(from: player)
+            guard let self, self.artworkID == id else { return }
+            self.artwork = image
+        }
+    }
+
+    nonisolated private static func fetchArtwork(from player: Player) async -> NSImage? {
+        switch player {
+        case .spotify:
+            let source = Self.script(for: player, "return artwork url of current track")
+            guard let link = await NotchAppleScript.run(source)?.string, let url = URL(string: link) else {
+                return nil
+            }
+            let download = try? await URLSession.shared.data(from: url)
+            guard let data = download?.0 else { return nil }
+            return NSImage(data: data)
+        case .music:
+            let source = Self.script(
+                for: player,
+                "if (count of artworks of current track) > 0 then return data of artwork 1 of current track"
+            )
+            guard let data = await NotchAppleScript.run(source)?.data, !data.isEmpty else { return nil }
+            return NSImage(data: data)
+        }
+    }
+
+    /// Wraps commands so they never launch a player that is not running.
+    nonisolated private static func script(for player: Player, _ body: String) -> String {
+        let name = player.scriptName
+        return "if application \"" + name + "\" is running then\n"
+            + "tell application \"" + name + "\"\n"
+            + body + "\n"
+            + "end tell\n"
+            + "end if"
+    }
+}
+
+/// Runs AppleScript one at a time off the main thread (the first run may wait for the user to
+/// allow VoiceInk to control the app).
+enum NotchAppleScript {
+    struct Result: Sendable {
+        let string: String?
+        let data: Data?
+    }
+
+    private static let queue = DispatchQueue(label: "com.prakashjoshipax.voiceink.notch-applescript", qos: .userInitiated)
+
+    static func run(_ source: String) async -> Result? {
+        await withCheckedContinuation { continuation in
+            queue.async {
+                var error: NSDictionary?
+                let descriptor = NSAppleScript(source: source)?.executeAndReturnError(&error)
+                guard error == nil, let descriptor else {
+                    continuation.resume(returning: nil)
+                    return
+                }
+                continuation.resume(returning: Result(string: descriptor.stringValue, data: descriptor.data))
+            }
+        }
+    }
+}
