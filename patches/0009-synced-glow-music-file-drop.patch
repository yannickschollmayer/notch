@@ -0,0 +1,311 @@
+import AppKit
+import UniformTypeIdentifiers
+import os
+
+/// What to do with files dropped on the notch.
+enum NotchDropAction {
+    case transcribe
+    case mp3
+    case airDrop
+}
+
+/// Files that are being dragged across the screen.
+struct NotchFileDrag: Equatable {
+    let urls: [URL]
+
+    var canTranscribe: Bool { urls.contains { SupportedMedia.isSupported(url: $0) } }
+    var canConvert: Bool { urls.contains { NotchFileActions.canConvertToMP3($0) } }
+}
+
+/// Progress or result of a drop action, shown in a card below the notch.
+struct NotchFileTask: Equatable {
+    enum Kind: Equatable {
+        case transcribe
+        case mp3
+    }
+
+    enum State: Equatable {
+        case working
+        case transcript(String)
+        case saved(URL)
+        case failed(String)
+    }
+
+    let id = UUID()
+    let kind: Kind
+    let fileName: String
+    var state: State
+
+    var isFinished: Bool {
+        if case .working = state { return false }
+        return true
+    }
+}
+
+/// Transcribe, convert to MP3 (like VideoLoader) or AirDrop the files dropped on the notch.
+@MainActor
+final class NotchFileActions {
+    private weak var engine: VoiceInkEngine?
+    private let model: NotchIslandModel
+    private var autoDismiss: Task<Void, Never>?
+    private let logger = Logger(subsystem: "com.prakashjoshipax.voiceink", category: "NotchFileActions")
+
+    init(engine: VoiceInkEngine, model: NotchIslandModel) {
+        self.engine = engine
+        self.model = model
+    }
+
+    func perform(_ action: NotchDropAction, on urls: [URL]) {
+        let files = urls.filter(\.isFileURL)
+        guard !files.isEmpty else { return }
+        switch action {
+        case .transcribe:
+            transcribe(files.filter { SupportedMedia.isSupported(url: $0) })
+        case .mp3:
+            convert(files.filter { Self.canConvertToMP3($0) })
+        case .airDrop:
+            airDrop(files)
+        }
+    }
+
+    func dismiss() {
+        autoDismiss?.cancel()
+        autoDismiss = nil
+        model.fileTask = nil
+    }
+
+    /// Videos, and audio that is not an MP3 yet.
+    nonisolated static func canConvertToMP3(_ url: URL) -> Bool {
+        let fileExtension = url.pathExtension.lowercased()
+        guard fileExtension != "mp3" else { return false }
+        guard let type = UTType(filenameExtension: fileExtension) else {
+            return SupportedMedia.isSupported(url: url)
+        }
+        return type.conforms(to: .movie) || type.conforms(to: .audio)
+    }
+
+    // MARK: Transcribe
+
+    private func transcribe(_ files: [URL]) {
+        guard !files.isEmpty, let engine else { return }
+        var task = NotchFileTask(kind: .transcribe, fileName: Self.name(of: files), state: .working)
+
+        guard let mode = ModeManager.shared.currentEffectiveConfiguration else {
+            task.state = .failed(String(localized: "Choose a mode in VoiceInk first.", table: "NotchIsland"))
+            show(task)
+            return
+        }
+
+        let manager = AudioTranscriptionManager.shared
+        let known = Set(manager.queue.map(\.id))
+        manager.addToQueue(urls: files)
+        let items = manager.queue.filter { !known.contains($0.id) }
+        guard !items.isEmpty else {
+            task.state = .failed(String(localized: "These files are already being transcribed.", table: "NotchIsland"))
+            show(task)
+            return
+        }
+
+        show(task)
+        manager.startProcessing(modelContext: engine.modelContext, engine: engine, mode: mode)
+
+        let started = task
+        Task { @MainActor [weak self] in
+            var result = started
+            // Same queue as "Transcribe Audio" in VoiceInk, so the results also land in the history.
+            var idleChecks = 0
+            while items.contains(where: { !$0.status.isTerminal }) {
+                try? await Task.sleep(nanoseconds: 300_000_000)
+                // Stopped from elsewhere (e.g. cancelled in the main window).
+                if !manager.isProcessingQueue {
+                    idleChecks += 1
+                    if idleChecks > 6 { break }
+                } else {
+                    idleChecks = 0
+                }
+            }
+
+            var texts: [String] = []
+            var failure: String?
+            for item in items {
+                switch item.status {
+                case .completed:
+                    if let transcription = item.transcription {
+                        texts.append(Self.text(of: transcription))
+                    }
+                case .failed(let message):
+                    failure = message
+                case .pending, .processing:
+                    failure = String(localized: "Canceled", table: "NotchIsland")
+                }
+            }
+
+            guard let self else { return }
+            let text = texts.joined(separator: "\n\n")
+            if !text.isEmpty {
+                _ = ClipboardManager.copyToClipboard(text)
+                result.state = .transcript(text)
+            } else {
+                result.state = .failed(failure ?? String(localized: "Nothing was recognized.", table: "NotchIsland"))
+            }
+            self.show(result)
+        }
+    }
+
+    /// The AI-cleaned text when that worked, the plain transcript otherwise.
+    private static func text(of transcription: Transcription) -> String {
+        if let enhanced = transcription.enhancedText, !enhanced.isEmpty, transcription.enhancementDuration != nil {
+            return enhanced
+        }
+        return transcription.text
+    }
+
+    // MARK: MP3
+
+    private func convert(_ files: [URL]) {
+        guard !files.isEmpty else { return }
+        var task = NotchFileTask(kind: .mp3, fileName: Self.name(of: files), state: .working)
+        guard let ffmpeg = Self.ffmpegURL() else {
+            task.state = .failed(
+                String(localized: "ffmpeg was not found. Open VideoLoader once, or install ffmpeg with Homebrew.", table: "NotchIsland")
+            )
+            show(task)
+            return
+        }
+        show(task)
+
+        let started = task
+        Task { @MainActor [weak self] in
+            var result = started
+            var saved: [URL] = []
+            var failed = false
+            for file in files {
+                if let output = await Self.convertToMP3(file, ffmpeg: ffmpeg) {
+                    saved.append(output)
+                } else {
+                    failed = true
+                }
+            }
+
+            guard let self else { return }
+            if let last = saved.last {
+                result.state = .saved(last)
+            } else {
+                result.state = .failed(String(localized: "The file could not be converted.", table: "NotchIsland"))
+            }
+            if failed {
+                self.logger.error("Notch MP3: \(files.count - saved.count, privacy: .public) file(s) failed")
+            }
+            self.show(result)
+        }
+    }
+
+    /// The ffmpeg VideoLoader brings along, or one installed with Homebrew.
+    nonisolated private static func ffmpegURL() -> URL? {
+        let home = FileManager.default.homeDirectoryForCurrentUser
+        let candidates = [
+            home.appendingPathComponent("Library/Application Support/VideoLoader/bin/ffmpeg"),
+            URL(fileURLWithPath: "/opt/homebrew/bin/ffmpeg"),
+            URL(fileURLWithPath: "/usr/local/bin/ffmpeg"),
+        ]
+        return candidates.first { FileManager.default.isExecutableFile(atPath: $0.path) }
+    }
+
+    /// Same folder VideoLoader saves to.
+    nonisolated private static func outputFolder() -> URL {
+        let downloads = FileManager.default.urls(for: .downloadsDirectory, in: .userDomainMask).first
+            ?? FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Downloads")
+        return downloads.appendingPathComponent("VideoLoader", isDirectory: true)
+    }
+
+    nonisolated private static func convertToMP3(_ input: URL, ffmpeg: URL) async -> URL? {
+        let folder = outputFolder()
+        do {
+            try FileManager.default.createDirectory(at: folder, withIntermediateDirectories: true)
+        } catch {
+            return nil
+        }
+        let base = input.deletingPathExtension().lastPathComponent
+        var output = folder.appendingPathComponent(base + ".mp3")
+        var counter = 2
+        while FileManager.default.fileExists(atPath: output.path) {
+            output = folder.appendingPathComponent(base + " " + String(counter) + ".mp3")
+            counter += 1
+        }
+        let target = output
+
+        let succeeded: Bool = await withCheckedContinuation { continuation in
+            let process = Process()
+            process.executableURL = ffmpeg
+            process.arguments = [
+                "-nostdin", "-y", "-hide_banner", "-loglevel", "error",
+                "-i", input.path, "-vn", "-c:a", "libmp3lame", "-b:a", "192k", target.path,
+            ]
+            process.standardInput = FileHandle.nullDevice
+            process.standardOutput = FileHandle.nullDevice
+            process.standardError = FileHandle.nullDevice
+            process.terminationHandler = { finished in
+                let ok = finished.terminationStatus == 0
+                // The handler keeps the process alive until it ends; then let both go.
+                finished.terminationHandler = nil
+                withExtendedLifetime(process) {}
+                continuation.resume(returning: ok)
+            }
+            do {
+                try process.run()
+            } catch {
+                continuation.resume(returning: false)
+            }
+        }
+
+        if !succeeded {
+            try? FileManager.default.removeItem(at: target)
+            return nil
+        }
+        return target
+    }
+
+    // MARK: AirDrop
+
+    private func airDrop(_ files: [URL]) {
+        // Let the drag finish first, then bring up the AirDrop window.
+        Task { @MainActor [weak self] in
+            try? await Task.sleep(nanoseconds: 200_000_000)
+            guard let service = NSSharingService(named: .sendViaAirDrop), service.canPerform(withItems: files) else {
+                var task = NotchFileTask(kind: .mp3, fileName: Self.name(of: files), state: .working)
+                task.state = .failed(String(localized: "AirDrop is not available.", table: "NotchIsland"))
+                self?.show(task)
+                return
+            }
+            NSApp.activate()
+            service.perform(withItems: files)
+        }
+    }
+
+    // MARK: Card
+
+    private func show(_ task: NotchFileTask) {
+        model.fileTask = task
+        autoDismiss?.cancel()
+        autoDismiss = nil
+        guard task.isFinished else { return }
+
+        let id = task.id
+        autoDismiss = Task { @MainActor [weak self] in
+            try? await Task.sleep(nanoseconds: 9_000_000_000)
+            // Stays while the pointer is on it.
+            while let self, !Task.isCancelled, self.model.fileTask?.id == id {
+                if !self.model.isHovering {
+                    self.model.fileTask = nil
+                    return
+                }
+                try? await Task.sleep(nanoseconds: 1_000_000_000)
+            }
+        }
+    }
+
+    private static func name(of files: [URL]) -> String {
+        guard let first = files.first else { return "" }
+        return files.count > 1 ? first.lastPathComponent + " +" + String(files.count - 1) : first.lastPathComponent
+    }
+}
