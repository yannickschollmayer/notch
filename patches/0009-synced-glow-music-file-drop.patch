+            float soft = mix(1.2f, 2.2f, level);
+            float line = 1.0f - smoothstep(lineWidth, lineWidth + soft, e);
+            float strength = mix(0.28f, 0.36f, level);
+            float reach = mix(15.0f, 25.0f, level);
