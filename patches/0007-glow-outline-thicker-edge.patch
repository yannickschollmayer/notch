+    /// Signed distance to a rounded box centred at the origin (negative inside).
+    nonisolated private static func roundedBoxDistance(
+        x: CGFloat, y: CGFloat, halfWidth: CGFloat, halfHeight: CGFloat, radius: CGFloat
+    ) -> CGFloat {
+        let qx = abs(x) - halfWidth + radius
+        let qy = abs(y) - halfHeight + radius
+        let outside = (max(qx, 0) * max(qx, 0) + max(qy, 0) * max(qy, 0)).squareRoot()
+        return outside + min(max(qx, qy), 0) - radius
+    }
+
+    nonisolated private static func smoothMax(_ a: CGFloat, _ b: CGFloat, blend: CGFloat) -> CGFloat {
+        guard blend > 0 else { return max(a, b) }
+        let h = max(blend - abs(a - b), 0) / blend
+        return max(a, b) + h * h * blend * 0.25
+    }
 }
