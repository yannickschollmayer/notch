@@ -468,2 +471,17 @@ final class NotchIslandModel: ObservableObject {
 
+    /// Close beside and below the notch: enough to wake it, so you never have to touch the top
+    /// edge of the screen (where macOS brings in the menu bar). Only for hovering; clicks there
+    /// still go to the app below.
+    func isNear(_ point: NSPoint) -> Bool {
+        let frame = geometry.screenFrame
+        let width = geometry.notchWidth + (Self.hoverWing + Self.nearMargin) * 2
+        let height = geometry.notchHeight + Self.rowBonus + Self.nearDepth
+        return NSRect(x: frame.midX - width / 2, y: frame.maxY - height, width: width, height: height).contains(point)
+    }
+
+    /// On the island, or close enough to count as hovering it.
+    func senses(_ point: NSPoint) -> Bool {
+        containsPointer(point) || isNear(point)
+    }
+
     /// Whether the pointer counts as "on the island": the island, its card, and the gap between.
