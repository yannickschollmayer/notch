+/// A rounded rectangle whose corner radius is a share of its size.
+struct NotchProportionalRoundedRect: Shape {
+    let ratio: CGFloat
+
+    func path(in rect: CGRect) -> Path {
+        Path(roundedRect: rect, cornerRadius: min(rect.width, rect.height) * ratio, style: .continuous)
+    }
+}
