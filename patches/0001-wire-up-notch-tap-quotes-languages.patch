+    static func restrictedToPreferred(_ all: [String: String]) -> [String: String] {
+        let filtered = all.filter { code, _ in
+            code == "auto" || preferredLanguageBases.contains(baseLanguage(of: code))
+        }
+        // A model that supports none of them (e.g. an English-only model) keeps its own list.
+        return filtered.isEmpty ? all : filtered
+    }
+
+    private static func baseLanguage(of code: String) -> String {
+        let separators: Set<Character> = ["-", "_"]
+        let base = code.split(whereSeparator: { separators.contains($0) }).first.map(String.init) ?? code
+        return base.lowercased()
     }
 
