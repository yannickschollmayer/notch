+// MARK: - Drop on the island
+
+extension NotchIslandController: NotchDropHandling {
+    func dragEntered(with urls: [URL]) {
+        // Normally the drag was already noticed on its way here; if not, it starts now.
+        if model.fileDrag == nil, !urls.isEmpty {
+            beginFileDrag(urls)
+        }
+    }
+
+    func dragMoved(to point: NSPoint) -> NSDragOperation {
+        updatePointerState()
+        let zone = model.dropAction(at: point)
+        if zone != model.dropZone {
+            model.dropZone = zone
+            // A light click on the trackpad when the file reaches a target.
+            if let zone, model.fileDrag?.allows(zone) == true {
+                NSHapticFeedbackManager.defaultPerformer.perform(.alignment, performanceTime: .now)
+            }
+        }
+        guard let zone, model.fileDrag?.allows(zone) == true else { return [] }
+        return .copy
+    }
+
+    func dragLeft() {
+        if model.dropZone != nil {
+            model.dropZone = nil
+        }
+    }
+
+    func dropFiles(_ urls: [URL], at point: NSPoint) -> Bool {
+        let action = model.dropAction(at: point) ?? model.dropZone
+        let files = urls.isEmpty ? (model.fileDrag?.urls ?? []) : urls
+        guard let action, !files.isEmpty, NotchFileDrag(urls: files).allows(action) else {
+            endFileDrag()
+            return false
+        }
+        NSHapticFeedbackManager.defaultPerformer.perform(.levelChange, performanceTime: .now)
+        endFileDrag()
+        fileActions.perform(action, on: files)
+        return true
+    }
+}
