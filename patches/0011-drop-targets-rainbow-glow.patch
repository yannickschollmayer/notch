+/// Receives files dragged onto the island.
+@MainActor
+protocol NotchDropHandling: AnyObject {
+    func dragEntered(with urls: [URL])
+    /// Returns what a drop at this screen point would do (no operation: not possible here).
+    func dragMoved(to point: NSPoint) -> NSDragOperation
+    func dragLeft()
+    func dropFiles(_ urls: [URL], at point: NSPoint) -> Bool
+}
+
+/// Window content: hosts the SwiftUI island and takes part in drag and drop itself (plain AppKit,
+/// which works reliably in this non-activating panel).
+final class NotchIslandContainerView: NSView {
+    weak var dropHandler: NotchDropHandling?
+
+    override init(frame: NSRect) {
+        super.init(frame: frame)
+        wantsLayer = true
+        layer?.backgroundColor = NSColor.clear.cgColor
+        registerForDraggedTypes([.fileURL])
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func draggingEntered(_ sender: NSDraggingInfo) -> NSDragOperation {
+        MainActor.assumeIsolated { () -> NSDragOperation in
+            dropHandler?.dragEntered(with: Self.fileURLs(in: sender.draggingPasteboard))
+            return operation(for: sender)
+        }
+    }
+
+    override func draggingUpdated(_ sender: NSDraggingInfo) -> NSDragOperation {
+        MainActor.assumeIsolated {
+            operation(for: sender)
+        }
+    }
+
+    override func draggingExited(_ sender: NSDraggingInfo?) {
+        MainActor.assumeIsolated {
+            guard let dropHandler else { return }
+            dropHandler.dragLeft()
+        }
+    }
+
+    override func prepareForDragOperation(_ sender: NSDraggingInfo) -> Bool {
+        true
+    }
+
+    override func performDragOperation(_ sender: NSDraggingInfo) -> Bool {
+        MainActor.assumeIsolated { () -> Bool in
+            guard let window, let dropHandler else { return false }
+            let point = window.convertPoint(toScreen: sender.draggingLocation)
+            return dropHandler.dropFiles(Self.fileURLs(in: sender.draggingPasteboard), at: point)
+        }
+    }
+
+    private func operation(for sender: NSDraggingInfo) -> NSDragOperation {
+        guard let window, let dropHandler else { return [] }
+        return dropHandler.dragMoved(to: window.convertPoint(toScreen: sender.draggingLocation))
+    }
+
+    /// Finder hands out file reference URLs (/.file/id=…); these are turned into normal paths.
+    static func fileURLs(in pasteboard: NSPasteboard) -> [URL] {
+        let objects = pasteboard.readObjects(forClasses: [NSURL.self], options: [.urlReadingFileURLsOnly: true])
+        return ((objects as? [NSURL]) ?? []).compactMap { $0.filePathURL }
+    }
+}
