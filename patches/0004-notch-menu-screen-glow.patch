+/// Smooths the microphone level and turns the colours around the screen at a speed that
+/// follows the voice.
+final class NotchGlowAnimator {
+    private var level: Double = 0
+    private var angle: Double = 0
+    private var lastTime: TimeInterval?
+
+    func step(time: TimeInterval, targetLevel: Double, speaking: Bool) -> (level: Double, angle: Double) {
+        let delta = lastTime.map { min(max(time - $0, 0), 0.1) } ?? 0
+        lastTime = time
+        let rate = targetLevel > level ? 0.45 : 0.12
+        level += (targetLevel - level) * rate
+        let degreesPerSecond = speaking ? 40 + 120 * level : 22
+        angle = (angle + degreesPerSecond * delta).truncatingRemainder(dividingBy: 360)
+        return (level, angle)
+    }
+}
