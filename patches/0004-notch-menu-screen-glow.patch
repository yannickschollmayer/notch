+// MARK: - Island outline without the top edge
+
+struct NotchIslandRimShape: Shape {
+    var topCornerRadius: CGFloat
+    var bottomCornerRadius: CGFloat
+
+    var animatableData: AnimatablePair<CGFloat, CGFloat> {
+        get { AnimatablePair(topCornerRadius, bottomCornerRadius) }
+        set {
+            topCornerRadius = newValue.first
+            bottomCornerRadius = newValue.second
+        }
+    }
+
+    func path(in rect: CGRect) -> Path {
+        let top = topCornerRadius
+        let bottom = bottomCornerRadius
+        var path = Path()
+        path.move(to: CGPoint(x: rect.minX + top, y: rect.minY + top))
+        path.addLine(to: CGPoint(x: rect.minX + top, y: rect.maxY - bottom))
+        path.addQuadCurve(
+            to: CGPoint(x: rect.minX + top + bottom, y: rect.maxY),
+            control: CGPoint(x: rect.minX + top, y: rect.maxY)
+        )
+        path.addLine(to: CGPoint(x: rect.maxX - top - bottom, y: rect.maxY))
+        path.addQuadCurve(
+            to: CGPoint(x: rect.maxX - top, y: rect.maxY - bottom),
+            control: CGPoint(x: rect.maxX - top, y: rect.maxY)
+        )
+        path.addLine(to: CGPoint(x: rect.maxX - top, y: rect.minY + top))
+        return path
+    }
+}
+
+// MARK: - Screen edge glow (Siri style)
+
+/// One closed line along every screen edge that dips around the island, so the island's outline
+/// and the screen glow are the same light. Assumes the view is exactly as large as the screen.
+struct NotchScreenGlowShape: Shape {
+    var islandWidth: CGFloat
+    var islandHeight: CGFloat
+    var topCornerRadius: CGFloat
+    var bottomCornerRadius: CGFloat
+    var screenCornerRadius: CGFloat = 10
+
+    var animatableData: AnimatablePair<AnimatablePair<CGFloat, CGFloat>, AnimatablePair<CGFloat, CGFloat>> {
+        get {
+            AnimatablePair(
+                AnimatablePair(islandWidth, islandHeight),
+                AnimatablePair(topCornerRadius, bottomCornerRadius)
+            )
+        }
+        set {
+            islandWidth = newValue.first.first
+            islandHeight = newValue.first.second
+            topCornerRadius = newValue.second.first
+            bottomCornerRadius = newValue.second.second
+        }
+    }
+
+    func path(in rect: CGRect) -> Path {
+        let corner = min(screenCornerRadius, rect.width / 4, rect.height / 4)
+        let width = min(max(islandWidth, 0), max(0, rect.width - corner * 2))
+        let height = min(max(islandHeight, 0), rect.height / 2)
+        let top = min(topCornerRadius, width / 4)
+        let bottom = min(bottomCornerRadius, max(0, height - top), max(0, width / 2 - top))
+        let left = rect.midX - width / 2
+        let right = rect.midX + width / 2
+        let minY = rect.minY
+
+        var path = Path()
+        // Top edge right of the island, then clockwise around the screen.
+        path.move(to: CGPoint(x: right, y: minY))
+        path.addLine(to: CGPoint(x: rect.maxX - corner, y: minY))
+        path.addQuadCurve(to: CGPoint(x: rect.maxX, y: minY + corner), control: CGPoint(x: rect.maxX, y: minY))
+        path.addLine(to: CGPoint(x: rect.maxX, y: rect.maxY - corner))
+        path.addQuadCurve(to: CGPoint(x: rect.maxX - corner, y: rect.maxY), control: CGPoint(x: rect.maxX, y: rect.maxY))
+        path.addLine(to: CGPoint(x: rect.minX + corner, y: rect.maxY))
+        path.addQuadCurve(to: CGPoint(x: rect.minX, y: rect.maxY - corner), control: CGPoint(x: rect.minX, y: rect.maxY))
+        path.addLine(to: CGPoint(x: rect.minX, y: minY + corner))
+        path.addQuadCurve(to: CGPoint(x: rect.minX + corner, y: minY), control: CGPoint(x: rect.minX, y: minY))
+        path.addLine(to: CGPoint(x: left, y: minY))
+        // Down and around the island (same outline as NotchShape).
+        path.addQuadCurve(to: CGPoint(x: left + top, y: minY + top), control: CGPoint(x: left + top, y: minY))
+        path.addLine(to: CGPoint(x: left + top, y: minY + height - bottom))
+        path.addQuadCurve(
+            to: CGPoint(x: left + top + bottom, y: minY + height),
+            control: CGPoint(x: left + top, y: minY + height)
+        )
+        path.addLine(to: CGPoint(x: right - top - bottom, y: minY + height))
+        path.addQuadCurve(
+            to: CGPoint(x: right - top, y: minY + height - bottom),
+            control: CGPoint(x: right - top, y: minY + height)
+        )
+        path.addLine(to: CGPoint(x: right - top, y: minY + top))
+        path.addQuadCurve(to: CGPoint(x: right, y: minY), control: CGPoint(x: right - top, y: minY))
+        path.closeSubpath()
+        return path
+    }
+}
