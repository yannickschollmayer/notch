+/// Light around the whole screen while dictating: flowing PromoPulse gold that swells with your
+/// voice, then a calm silver pulse while the text is processed.
+struct NotchScreenGlow: View {
+    let phase: NotchIslandPhase
+    let islandSize: CGSize
+    let islandShape: NotchShape
+    let meter: () -> AudioMeter
+
+    @State private var animator = NotchGlowAnimator()
+
+    var body: some View {
+        let outline = NotchScreenGlowShape(
+            islandWidth: islandSize.width,
+            islandHeight: islandSize.height,
+            topCornerRadius: islandShape.topCornerRadius,
+            bottomCornerRadius: islandShape.bottomCornerRadius
+        )
+        let speaking = phase == .recording || phase == .liveText
+
+        TimelineView(.animation(minimumInterval: 1.0 / 30.0)) { context in
+            let time = context.date.timeIntervalSinceReferenceDate
+            let target = speaking ? max(0, min(1, pow(meter().averagePower, 0.7))) : 0
+            let step = animator.step(time: time, targetLevel: target, speaking: speaking)
+            let level = CGFloat(step.level)
+            let pulse = CGFloat((sin(time * 2.4) + 1) / 2)
+
+            let gradient = AngularGradient(
+                gradient: Gradient(colors: speaking ? NotchIslandStyle.speakingGradient : NotchIslandStyle.processingGradient),
+                center: .center,
+                angle: .degrees(step.angle)
+            )
+            let haloWidth: CGFloat = speaking ? 18 + 36 * level : 12 + 8 * pulse
+            let haloOpacity: Double = speaking ? 0.55 + 0.4 * Double(level) : 0.3 + 0.25 * Double(pulse)
+            let coreWidth: CGFloat = speaking ? 3 + 3 * level : 2
+            let coreOpacity: Double = speaking ? 0.85 : 0.45 + 0.3 * Double(pulse)
+
+            ZStack {
+                outline
+                    .stroke(gradient, lineWidth: haloWidth)
+                    .blur(radius: haloWidth * 0.6)
+                    .opacity(haloOpacity)
+                outline
+                    .stroke(gradient, lineWidth: coreWidth)
+                    .blur(radius: 1.5)
+                    .opacity(coreOpacity)
+            }
+        }
+        .allowsHitTesting(false)
+    }
+}
