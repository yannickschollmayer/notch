diff --git a/VoiceInk/Features/Recording/Presentation/NotchScreenGlowWindow.swift b/VoiceInk/Features/Recording/Presentation/NotchScreenGlowWindow.swift
new file mode 100644
index 0000000..860e4ff
--- /dev/null
+++ b/VoiceInk/Features/Recording/Presentation/NotchScreenGlowWindow.swift
@@ -0,0 +1,316 @@
+import AppKit
+import QuartzCore
+
+/// Siri-style light along the screen edges while dictating.
+///
+/// Drawn entirely with Core Animation: the soft edge masks are rendered once per screen size and
+/// the colours turn via a layer animation on the GPU, so nothing is redrawn on the main thread.
+/// The only per-frame work is setting two layer opacities from the microphone level.
+@MainActor
+final class NotchScreenGlowWindow {
+    enum Mode {
+        case speaking
+        case processing
+    }
+
+    private var panel: NSPanel?
+    private var screenFrame: NSRect = .zero
+    private var isShown = false
+    private var mode: Mode?
+
+    private let container = CALayer()
+    private let baseGlow = CALayer()
+    private let swellGlow = CALayer()
+    private let baseMask = CALayer()
+    private let swellMask = CALayer()
+    private let baseGradient = CAGradientLayer()
+    private let swellGradient = CAGradientLayer()
+
+    private var meter: (() -> AudioMeter)?
+    private var levelTimer: Timer?
+    private var smoothedLevel: Double = 0
+    private var hideTask: Task<Void, Never>?
+
+    private static var maskCache: [String: (base: CGImage, swell: CGImage)] = [:]
+    private static let easing = CAMediaTimingFunction(controlPoints: 0.4, 0, 0.2, 1)
+
+    private static let speakingColors: [CGColor] = [
+        0xFFE08A, 0xFDCA3F, 0xFCA311, 0xF59E0B, 0xFFD978, 0xFFFFFF, 0xFDCA3F, 0xFFE08A,
+    ].map(color)
+    private static let processingColors: [CGColor] = [
+        0xFFFFFF, 0xE7E9EE, 0xB5BCC8, 0xFFE08A, 0xE7E9EE, 0xB5BCC8, 0xE7E9EE, 0xFFFFFF,
+    ].map(color)
+
+    private static func color(_ hex: Int) -> CGColor {
+        CGColor(
+            srgbRed: CGFloat((hex >> 16) & 0xFF) / 255,
+            green: CGFloat((hex >> 8) & 0xFF) / 255,
+            blue: CGFloat(hex & 0xFF) / 255,
+            alpha: 1
+        )
+    }
+
+    init() {
+        container.opacity = 0
+        for (glow, mask, gradient) in [(baseGlow, baseMask, baseGradient), (swellGlow, swellMask, swellGradient)] {
+            gradient.type = .conic
+            gradient.startPoint = CGPoint(x: 0.5, y: 0.5)
+            gradient.endPoint = CGPoint(x: 0.5, y: 0)
+            gradient.colors = Self.speakingColors
+            glow.addSublayer(gradient)
+            glow.mask = mask
+            container.addSublayer(glow)
+        }
+        swellGlow.opacity = 0
+    }
+
+    // MARK: Public API
+
+    /// Renders the edge masks in the background so the first dictation starts without a hitch.
+    func prepare(for screen: NSScreen) {
+        let size = screen.frame.size
+        let key = Self.cacheKey(for: size)
+        guard Self.maskCache[key] == nil else { return }
+        DispatchQueue.global(qos: .utility).async {
+            guard let masks = NotchScreenGlowWindow.renderMasks(size: size) else { return }
+            DispatchQueue.main.async {
+                MainActor.assumeIsolated {
+                    NotchScreenGlowWindow.maskCache[key] = masks
+                }
+            }
+        }
+    }
+
+    /// Fades the glow in on the given screen (does nothing if it is already showing there).
+    func show(on screen: NSScreen, meter: @escaping () -> AudioMeter) {
+        self.meter = meter
+        hideTask?.cancel()
+        hideTask = nil
+
+        let panel = ensurePanel()
+        if screenFrame != screen.frame {
+            screenFrame = screen.frame
+            panel.setFrame(screen.frame, display: false)
+            layout(size: screen.frame.size)
+        }
+
+        guard !isShown else { return }
+        isShown = true
+        panel.orderFrontRegardless()
+        startSpinning()
+        animate(container, to: 1, duration: 0.35)
+        startLevelTimer()
+    }
+
+    func setMode(_ newMode: Mode) {
+        guard newMode != mode else { return }
+        mode = newMode
+        let colors = newMode == .speaking ? Self.speakingColors : Self.processingColors
+
+        for gradient in [baseGradient, swellGradient] {
+            let change = CABasicAnimation(keyPath: "colors")
+            change.fromValue = gradient.presentation()?.colors ?? gradient.colors
+            change.toValue = colors
+            change.duration = 0.45
+            change.timingFunction = Self.easing
+            gradient.colors = colors
+            gradient.add(change, forKey: "colors")
+        }
+
+        switch newMode {
+        case .speaking:
+            baseGlow.removeAnimation(forKey: "pulse")
+            animate(baseGlow, to: 0.8, duration: 0.3)
+        case .processing:
+            animate(swellGlow, to: 0, duration: 0.3)
+            let pulse = CABasicAnimation(keyPath: "opacity")
+            pulse.fromValue = 0.35
+            pulse.toValue = 0.85
+            pulse.duration = 0.9
+            pulse.autoreverses = true
+            pulse.repeatCount = .infinity
+            pulse.timingFunction = CAMediaTimingFunction(name: .easeInEaseOut)
+            baseGlow.add(pulse, forKey: "pulse")
+        }
+    }
+
+    func hide() {
+        guard isShown else { return }
+        isShown = false
+        mode = nil
+        stopLevelTimer()
+        animate(container, to: 0, duration: 0.45)
+        hideTask = Task { @MainActor [weak self] in
+            try? await Task.sleep(nanoseconds: 500_000_000)
+            guard let self, !Task.isCancelled else { return }
+            self.panel?.orderOut(nil)
+            self.baseGlow.removeAllAnimations()
+            self.baseGradient.removeAnimation(forKey: "spin")
+            self.swellGradient.removeAnimation(forKey: "spin")
+            self.swellGlow.opacity = 0
+            self.smoothedLevel = 0
+        }
+    }
+
+    func destroy() {
+        stopLevelTimer()
+        hideTask?.cancel()
+        panel?.orderOut(nil)
+        panel?.close()
+        panel = nil
+        isShown = false
+        mode = nil
+    }
+
+    // MARK: Window and layers
+
+    private func ensurePanel() -> NSPanel {
+        if let panel { return panel }
+
+        let newPanel = NSPanel(
+            contentRect: .zero,
+            styleMask: [.borderless, .nonactivatingPanel],
+            backing: .buffered,
+            defer: false
+        )
+        newPanel.isFloatingPanel = true
+        // Just below the island window, so the island covers the glow along the top edge.
+        newPanel.level = NSWindow.Level(rawValue: NSWindow.Level.statusBar.rawValue + 2)
+        newPanel.backgroundColor = .clear
+        newPanel.isOpaque = false
+        newPanel.hasShadow = false
+        newPanel.hidesOnDeactivate = false
+        newPanel.ignoresMouseEvents = true
+        newPanel.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary, .stationary, .ignoresCycle]
+
+        let root = CALayer()
+        root.addSublayer(container)
+        let view = NSView()
+        view.layer = root
+        view.wantsLayer = true
+        newPanel.contentView = view
+
+        panel = newPanel
+        return newPanel
+    }
+
+    private func layout(size: CGSize) {
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+
+        let bounds = CGRect(origin: .zero, size: size)
+        container.frame = bounds
+        // The gradients spin, so they must cover the screen at every angle.
+        let diagonal = (size.width * size.width + size.height * size.height).squareRoot()
+        for (glow, mask, gradient) in [(baseGlow, baseMask, baseGradient), (swellGlow, swellMask, swellGradient)] {
+            glow.frame = bounds
+            mask.frame = bounds
+            gradient.bounds = CGRect(x: 0, y: 0, width: diagonal, height: diagonal)
+            gradient.position = CGPoint(x: bounds.midX, y: bounds.midY)
+        }
+
+        let key = Self.cacheKey(for: size)
+        let masks = Self.maskCache[key] ?? Self.renderMasks(size: size)
+        if let masks {
+            Self.maskCache[key] = masks
+            baseMask.contents = masks.base
+            swellMask.contents = masks.swell
+        }
+
+        CATransaction.commit()
+    }
+
+    private func startSpinning() {
+        for (gradient, turn, duration) in [(baseGradient, 2 * Double.pi, 7.0), (swellGradient, -2 * Double.pi, 10.0)] {
+            guard gradient.animation(forKey: "spin") == nil else { continue }
+            let spin = CABasicAnimation(keyPath: "transform.rotation.z")
+            spin.fromValue = 0
+            spin.toValue = turn
+            spin.duration = duration
+            spin.repeatCount = .infinity
+            gradient.add(spin, forKey: "spin")
+        }
+    }
+
+    private func animate(_ layer: CALayer, to opacity: Float, duration: CFTimeInterval) {
+        CATransaction.begin()
+        CATransaction.setAnimationDuration(duration)
+        CATransaction.setAnimationTimingFunction(Self.easing)
+        layer.opacity = opacity
+        CATransaction.commit()
+    }
+
+    // MARK: Voice level
+
+    private func startLevelTimer() {
+        guard levelTimer == nil else { return }
+        let timer = Timer(timeInterval: 1.0 / 30.0, repeats: true) { [weak self] _ in
+            MainActor.assumeIsolated {
+                self?.updateLevel()
+            }
+        }
+        RunLoop.main.add(timer, forMode: .common)
+        levelTimer = timer
+    }
+
+    private func stopLevelTimer() {
+        levelTimer?.invalidate()
+        levelTimer = nil
+    }
+
+    private func updateLevel() {
+        guard mode == .speaking, let meter else { return }
+        let target = max(0, min(1, pow(meter().averagePower, 0.7)))
+        let rate = target > smoothedLevel ? 0.5 : 0.15
+        smoothedLevel += (target - smoothedLevel) * rate
+
+        CATransaction.begin()
+        CATransaction.setAnimationDuration(1.0 / 30.0)
+        CATransaction.setAnimationTimingFunction(CAMediaTimingFunction(name: .linear))
+        baseGlow.opacity = Float(0.75 + 0.25 * smoothedLevel)
+        swellGlow.opacity = Float(0.1 + 0.9 * smoothedLevel)
+        CATransaction.commit()
+    }
+
+    // MARK: Masks
+
+    private static func cacheKey(for size: CGSize) -> String {
+        "\(Int(size.width))x\(Int(size.height))"
+    }
+
+    /// Soft white lines along the screen edge (alpha is what counts in a mask). Rendered at 1x:
+    /// the light is soft anyway and the images stay small.
+    nonisolated private static func renderMasks(size: CGSize) -> (base: CGImage, swell: CGImage)? {
+        guard
+            let base = renderEdge(size: size, lineWidth: 6, blur: 16),
+            let swell = renderEdge(size: size, lineWidth: 34, blur: 46)
+        else { return nil }
+        return (base, swell)
+    }
+
+    nonisolated private static func renderEdge(size: CGSize, lineWidth: CGFloat, blur: CGFloat) -> CGImage? {
+        let width = max(1, Int(size.width.rounded(.up)))
+        let height = max(1, Int(size.height.rounded(.up)))
+        guard
+            let context = CGContext(
+                data: nil,
+                width: width,
+                height: height,
+                bitsPerComponent: 8,
+                bytesPerRow: 0,
+                space: CGColorSpaceCreateDeviceRGB(),
+                bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
+            )
+        else { return nil }
+
+        let rect = CGRect(x: 0, y: 0, width: CGFloat(width), height: CGFloat(height))
+        let path = CGPath(roundedRect: rect, cornerWidth: 12, cornerHeight: 12, transform: nil)
+        let white = CGColor(gray: 1, alpha: 1)
+        context.setShadow(offset: .zero, blur: blur, color: white)
+        context.setStrokeColor(white)
+        context.setLineWidth(lineWidth)
+        context.addPath(path)
+        context.strokePath()
+        return context.makeImage()
+    }
+}
