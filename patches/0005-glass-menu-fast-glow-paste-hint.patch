diff --git a/VoiceInk/Infrastructure/SystemIntegration/Accessibility/PasteTargetCheck.swift b/VoiceInk/Infrastructure/SystemIntegration/Accessibility/PasteTargetCheck.swift
new file mode 100644
index 0000000..32452bd
--- /dev/null
+++ b/VoiceInk/Infrastructure/SystemIntegration/Accessibility/PasteTargetCheck.swift
@@ -0,0 +1,55 @@
+import AppKit
+import ApplicationServices
+
+/// Asks Accessibility whether the focused element of the frontmost app can take typed text, so the
+/// notch can say "copied, press ⌘V" when a dictation had nowhere to go.
+enum PasteTargetCheck {
+    /// Roles that never take text input.
+    private static let nonTextRoles: Set<String> = [
+        "AXApplication", "AXWindow", "AXList", "AXOutline", "AXTable", "AXBrowser", "AXCell", "AXRow",
+        "AXButton", "AXImage", "AXScrollArea", "AXSplitGroup", "AXToolbar", "AXTabGroup",
+        "AXMenuBar", "AXMenu", "AXMenuItem", "AXCheckBox", "AXRadioButton", "AXPopUpButton",
+        "AXSlider", "AXLink", "AXStaticText", "AXWebArea",
+    ]
+
+    /// true: a text field is focused. false: certainly nothing to type into.
+    /// nil: unknown (no Accessibility access, or the app does not say), treat as fine.
+    @MainActor
+    static func focusedElementAcceptsText() -> Bool? {
+        guard AXIsProcessTrusted() else { return nil }
+        guard let app = NSWorkspace.shared.frontmostApplication else { return false }
+
+        let root = AXUIElementCreateApplication(app.processIdentifier)
+        // Never wait long on an app that does not answer.
+        AXUIElementSetMessagingTimeout(root, 0.3)
+
+        let read = AccessibilityFocusReader.focusedElement(in: root)
+        guard let element = read.element else {
+            // The app answered but nothing has focus (e.g. the desktop in Finder).
+            return read.error == .noValue ? false : nil
+        }
+        AXUIElementSetMessagingTimeout(element, 0.3)
+
+        let role = AccessibilityFocusReader.stringAttribute(kAXRoleAttribute as CFString, from: element)
+        if let editable = AccessibilityFocusReader.editableState(of: element, role: role) {
+            return editable
+        }
+
+        // Web editors and custom text views: a text selection or a writable value means it takes text.
+        var range: CFTypeRef?
+        if AXUIElementCopyAttributeValue(element, kAXSelectedTextRangeAttribute as CFString, &range) == .success {
+            return true
+        }
+        var settable: DarwinBoolean = false
+        if AXUIElementIsAttributeSettable(element, kAXValueAttribute as CFString, &settable) == .success,
+            settable.boolValue
+        {
+            return true
+        }
+
+        if let role, nonTextRoles.contains(role) {
+            return false
+        }
+        return nil
+    }
+}
